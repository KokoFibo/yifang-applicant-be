# Hash SHA-256 dari token API admin (token aslinya hanya disimpan di Cloudflare)
ADMIN_API_TOKEN_HASH=

# Penyimpanan file pelamar (KTP, KK, ijazah, dst.)
# private = hanya lewat presigned URL 10 menit (disarankan; juga default bila baris ini dihapus)
APPLICANT_FILE_DISK=s3
APPLICANT_FILE_VISIBILITY=private

# Opsional: batasi API admin hanya untuk host tertentu (pisahkan dengan koma). Kosong = semua host.
# Contoh: ADMIN_API_HOSTS=api-applicant.yifang.co.id
ADMIN_API_HOSTS=
