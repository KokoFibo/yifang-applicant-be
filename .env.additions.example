# ===== Sesuaikan di .env proyek Laravel baru (ubah baris yang sudah ada, jangan dobel) =====
APP_NAME="Portal Calon Karyawan"
APP_URL=http://localhost:8000

# Sesi: cookie milik masing-masing domain (jangan isi SESSION_DOMAIN)
SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=file      # Laravel 11+ (Laravel 10: CACHE_DRIVER=file)

# MySQL: database yang SAMA dengan aplikasi lama (tabel applicantdatas & applicantfiles)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_database_anda
DB_USERNAME=portal_pelamar
DB_PASSWORD=password_anda

# Gmail SMTP. MAIL_PASSWORD = "App Password" 16 karakter dari akun Google
# (aktifkan verifikasi 2 langkah dulu), BUKAN password login Gmail.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yifangindonesia@gmail.com
MAIL_PASSWORD=ISI_APP_PASSWORD_DI_SINI
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="yifangindonesia@gmail.com"
MAIL_FROM_NAME="Admin Yifang Indonesia"   # nama pengirim per perusahaan diatur di database

# AWS S3
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# 'public' sementara (sesuai permintaan). Pilihan: public | public-policy | private. Ganti 'private' sebelum dipakai publik.
APPLICANT_FILE_DISK=s3
APPLICANT_FILE_VISIBILITY=public

# ===== Produksi =====
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
